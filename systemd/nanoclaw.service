[Unit]
Description=NanoClaw
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__WORKDIR__
ExecStart=/usr/bin/node dist/index.js
ExecStop=/bin/sh -c 'docker ps -q --filter label=nanoclaw-install | xargs -r -P 8 docker stop'
TimeoutStopSec=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
