# Per-instance .env, generated by `make new-instance NAME=<name>`.
# Don't hand-edit channel tokens here — install channels the same way you
# do for a single-install: run `/add-telegram`, `/add-slack`, etc. from a
# Claude Code session with NCL_INSTANCE=<name> set, and the skill will
# write tokens here for you (via setup/index.ts --step set-env, which is
# instance-aware).
#
# Lines containing __PLACEHOLDER__ are substituted by
# scripts/render-instance-env.sh from instances.conf at generation time.

ASSISTANT_NAME=Andy

# OneCLI gateway URL — auto-assigned from instances.conf so this instance
# doesn't collide with peer instances on the same host.
ONECLI_URL=__ONECLI_URL__
ONECLI_API_KEY=

# IANA timezone for scheduled tasks and message formatting.
# TZ=Europe/London
