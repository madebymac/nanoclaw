# Per-instance .env. For managed instances, generated by
# `make new-instance NAME=<name>` — do not pre-render this file by hand.
# After generation, edit your instances/<name>/.env to add channel tokens.
#
# Lines starting with __PLACEHOLDER__ are substituted by
# scripts/render-instance-env.sh.

ASSISTANT_NAME=Andy

# OneCLI gateway URL — auto-assigned from instances.conf.
ONECLI_URL=__ONECLI_URL__
ONECLI_API_KEY=

# IANA timezone for scheduled tasks and message formatting.
# TZ=Europe/London

# Channel tokens. Add one block per channel you wire to this instance.
# Examples (uncomment + fill the ones you use):
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
