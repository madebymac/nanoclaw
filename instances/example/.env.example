# Per-instance .env template. Copy to instances/<name>/.env and edit.
#
# Each instance runs an independent NanoClaw host on the same checkout:
# distinct DB, distinct OneCLI gateway (different ports), distinct channel
# credentials, distinct systemd unit. The host process reads NCL_INSTANCE
# from systemd Environment= and routes data/, groups/, store/, logs/ under
# instances/<name>/.

# Display name for the assistant.
ASSISTANT_NAME=Andy

# OneCLI gateway URL — each instance must point at its own gateway on a
# unique port triple. The default single-install port is 10254; pick
# 10354, 10454, etc. for additional instances.
ONECLI_URL=http://127.0.0.1:10354
ONECLI_API_KEY=

# IANA timezone for scheduled tasks and message formatting.
# TZ=Europe/London

# Channel tokens go here, one per channel. Add the same keys you'd add to
# a single-install .env (TELEGRAM_BOT_TOKEN=..., etc.).
