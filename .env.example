# Automatic PR review (opt-in) — see docs/pr-review.md
# Periodically scans open PRs across the reviewer agent's GitHub App
# installation and instructs it to review any the bot hasn't reviewed yet.
# The "needs review?" check is pure GitHub REST (no AI tokens); the agent is
# only woken when a PR actually needs review.
# PR_REVIEW_ENABLED=true
# PR_REVIEW_AGENT_GROUP_ID=<reviewer agent group id>   # must have a github_app_identity
# PR_REVIEW_INTERVAL_MS=60000                           # scan cadence (min 15000)
# PR_REVIEW_COOLDOWN_MS=1800000                         # re-dispatch cooldown if no review lands (min 60000)
