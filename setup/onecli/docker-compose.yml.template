# OneCLI gateway compose file.
#
# Rendered into ~/.onecli/docker-compose.yml by setup/onecli.ts and brought
# up with `docker compose --project-directory ~/.onecli -p onecli up -d`.
#
# Differences from the upstream onecli.sh installer's compose file:
#   - No top-level `name:` field. The upstream file pins `name: onecli`,
#     which compose treats as authoritative over the `-p` flag. We control
#     project name via `-p` instead.
#   - No `container_name: onecli` on the onecli service. Without it,
#     compose auto-names the container (onecli-onecli-1).
#
# Bind-address + version overrides come from the .env that lives in the
# same directory and is auto-loaded by compose:
#   ONECLI_VERSION       image tag for ghcr.io/onecli/onecli (pin this).
#   ONECLI_APP_PORT      host port for the web/API (default 10254).
#   ONECLI_GATEWAY_PORT  host port for the gateway (default 10255).
#   POSTGRES_PORT        host port for postgres (default 5432).
#   ONECLI_BIND_HOST     host address to bind to (default 127.0.0.1).
#   POSTGRES_USER/PASSWORD/DB defaults are fine; override if you need to.
#   NEXTAUTH_SECRET      auth secret for the gateway. Generated once by
#                        setup/onecli.ts at first install.

services:
  postgres:
    image: postgres:18-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-onecli}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-onecli}
      POSTGRES_DB: ${POSTGRES_DB:-onecli}
    volumes:
      - pgdata:/var/lib/postgresql
    ports:
      - "${ONECLI_BIND_HOST:-127.0.0.1}:${POSTGRES_PORT:-5432}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-onecli}"]
      interval: 5s
      timeout: 3s
      start_period: 15s
      retries: 10
    networks:
      - onecli

  onecli:
    image: ghcr.io/onecli/onecli:${ONECLI_VERSION:-latest}
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "${ONECLI_BIND_HOST:-127.0.0.1}:${ONECLI_APP_PORT:-10254}:10254"
      - "${ONECLI_BIND_HOST:-127.0.0.1}:${ONECLI_GATEWAY_PORT:-10255}:10255"
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER:-onecli}:${POSTGRES_PASSWORD:-onecli}@postgres:5432/${POSTGRES_DB:-onecli}
      # __NEXTAUTH_SECRET_LINE__  (rendered by setup/onecli.ts — do not remove)
      APP_URL: http://${ONECLI_BIND_HOST:-127.0.0.1}:${ONECLI_APP_PORT:-10254}
      # NextAuth builds OAuth callback URLs from NEXTAUTH_URL. The image
      # bakes http://localhost:10254 as the default, which sends GitHub
      # back to the wrong port on any non-default-port install. Bind to
      # 127.0.0.1 (not ONECLI_BIND_HOST, which may be the docker bridge
      # IP 172.17.0.1) since OAuth providers redirect the user's browser,
      # which lives on the host.
      NEXTAUTH_URL: http://127.0.0.1:${ONECLI_APP_PORT:-10254}
      # The image's Next.js bundle also reads NEXT_PUBLIC_APP_URL (with a
      # hardcoded "http://localhost:10254" fallback) when constructing the
      # /app-connect OAuth redirect_uri for GitHub Apps and the Redirect
      # URI shown in the UI. Without this override, non-default-port
      # installs send users to localhost:10254 mid-OAuth even with
      # NEXTAUTH_URL set correctly (NextAuth only governs its own
      # /api/auth/callback/* routes, not OneCLI's /api/apps/* flow).
      NEXT_PUBLIC_APP_URL: http://127.0.0.1:${ONECLI_APP_PORT:-10254}
      GATEWAY_API_URL: http://${ONECLI_BIND_HOST:-127.0.0.1}:${ONECLI_GATEWAY_PORT:-10255}
    volumes:
      - app-data:/app/data
    networks:
      - onecli

volumes:
  pgdata:
  app-data:

networks:
  onecli:
    driver: bridge
